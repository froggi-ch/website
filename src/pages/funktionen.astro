---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Features from '../components/Features.astro';
import Templates from '../components/Templates.astro';
import Security from '../components/Security.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Funktionen — Froggi"
  description="Eigene Strukturen, Berechtigungen, Single Sign-on, Änderungsprotokoll, Import & Export, offene API, der Vorlagen-Marktplatz und Betrieb für sensible Daten."
>
  <Nav />
  <main id="inhalt">
    <Features first />
    <Templates />
    <Security />
    <CtaBand />
  </main>
  <Footer />
</Base>

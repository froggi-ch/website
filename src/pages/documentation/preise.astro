---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Plans from '../../components/Plans.astro';
import PricingFaq from '../../components/PricingFaq.astro';
import CtaBand from '../../components/CtaBand.astro';
import Footer from '../../components/Footer.astro';
import { plan, price } from '../../lib/plans';

const [starter, pro, business] = ['starter', 'pro', 'business'].map((id) => price(plan(id)));
---

<Base
  title="Preise — Froggi"
  description={`Starter ab ${starter}, Professional ${pro}, Business ${business} pro Monat, Enterprise auf Anfrage. Einführungspreise, exkl. MWST.`}
>
  <Nav />
  <main id="inhalt">
    <Plans first />
    <PricingFaq />
    <CtaBand
      title="Welcher Plan passt?"
      text="Wir rechnen mit Ihnen durch, wie viele Objekte Sie haben – und zeigen Froggi mit Ihren eigenen Abläufen."
      secondary={{ label: 'Alle Funktionen', href: '/documentation/funktionen' }}
    />
  </main>
  <Footer />
</Base>

---
import Base from '../../layouts/Base.astro';
import TimoNav from '../../components/timo/TimoNav.astro';
import TimoFooter from '../../components/timo/TimoFooter.astro';

// timo is a separate app from the Froggi platform, published by J.Huser IT Services.
// This page is its App Store marketing and support URL; keep the prices and limits in
// step with the app (timo repo: docs/APPSTORE.md, "Preismodell").
const supportMail = 'hello@froggi.ch';

const features = [
  {
    title: 'Zeit erfassen',
    items: [
      'Timer mit Pause, auch im Widget, auf dem Sperrbildschirm und in der Dynamic Island',
      'Einträge nachtragen und duplizieren, pro Kunde, Projekt und Leistung',
      'Stundensätze und Verrechnungstakt pro Leistung, Kunde oder Projekt',
      'Zusatzpositionen wie Anfahrt (CHF/km, auch hin & zurück) oder Parkgebühren',
    ],
  },
  {
    title: 'Rechnungen',
    items: [
      'Monatsrechnungen auf Knopfdruck aus allen offenen Einträgen',
      'Swiss QR-Rechnung nach SIX-Standard, mit deinem Logo und deiner Farbe',
      'Versand per E-Mail oder WhatsApp, Status von Entwurf bis bezahlt, Mahnungen',
      'Sprache pro Kunde: Deutsch, Französisch, Italienisch oder Englisch',
    ],
  },
  {
    title: 'Kunden & Buchhaltung',
    items: [
      'Kunden aus den Kontakten übernehmen, direkt anrufen oder anschreiben',
      'Einnahmen und Ausgaben mit Belegen, Zahlungseingänge aus Rechnungen',
      'Erfolgsrechnung, Bilanz und MWST-Abrechnung (effektiv oder Saldosteuersatz)',
      'CSV-Export für den Treuhänder, PDF für die Steuererklärung',
    ],
  },
];

const plans = [
  { label: 'Zeiterfassung, Timer, Widget, iCloud-Sync', free: 'unbegrenzt', pro: 'unbegrenzt' },
  { label: 'Kunden', free: 'unbegrenzt', pro: 'unbegrenzt' },
  { label: 'Rechnungen mit QR-Zahlteil', free: '5 pro Monat', pro: 'unbegrenzt' },
  { label: 'Logo und Farbe auf der Rechnung', free: '–', pro: '✓' },
  { label: 'Buchhaltung, MWST, Steuer-PDF', free: '–', pro: '✓' },
];

const faq = [
  {
    q: 'Wie stelle ich mein Abo von timo Pro wieder her?',
    a: 'In timo unter Mehr → timo Pro (auf dem Mac in den Einstellungen) auf «Käufe wiederherstellen» tippen. Das Abo gilt für dein Apple-Konto auf iPhone, iPad und Mac, auch für die Familienfreigabe.',
  },
  {
    q: 'Wie kündige ich das Abo?',
    a: 'In den Einstellungen deines Geräts: auf deinen Namen tippen → Abonnements → timo Pro. Das Abo läuft bis zum Ende der bezahlten Periode. Danach bleiben alle Rechnungen und Daten erhalten; nur neue Rechnungen über der Gratis-Grenze und Logo, Farbe und Buchhaltung brauchen wieder Pro.',
  },
  {
    q: 'Meine Daten erscheinen nicht auf dem anderen Gerät.',
    a: 'timo gleicht über dein eigenes iCloud ab. Prüfe, ob beide Geräte mit demselben Apple-Konto angemeldet sind und iCloud für timo eingeschaltet ist. Der erste Abgleich kann einige Minuten dauern; öffne timo dazu auf beiden Geräten.',
  },
  {
    q: 'Warum hat meine Rechnung keinen QR-Zahlteil?',
    a: 'Der QR-Zahlteil braucht eine gültige IBAN und vollständige Adressen (Name, PLZ und Ort) von dir und vom Kunden, und es gibt ihn nur für CHF und EUR. timo zeigt auf der Rechnung an, was fehlt.',
  },
  {
    q: 'Wie lösche ich alle meine Daten?',
    a: 'In timo unter Einstellungen → Daten zurücksetzen → «Alle Daten löschen». Mit eingeschaltetem iCloud-Sync werden die Daten auch in iCloud und auf deinen anderen Geräten gelöscht.',
  },
];
---

<Base
  icon="/timo/icon.png"
  title="timo – Zeit & Rechnungen"
  description="timo ist die Zeiterfassung mit Swiss QR-Rechnung für Selbständige in der Schweiz. Für iPhone, iPad und Mac – ohne Konto, ohne Tracking."
>
  <TimoNav />
  <main id="inhalt" class="pt-[54px]">
    <!-- Hero -->
    <section class="px-4 sm:px-6 bg-white border-b border-brand-border">
      <div class="max-w-6xl mx-auto py-16 sm:py-24 grid gap-12 lg:grid-cols-[1.1fr_1fr] items-center">
        <div>
          <img src="/timo/icon.png" alt="" width="88" height="88" class="rounded-[20px] shadow-lift" />
          <h1 class="mt-6 text-4xl sm:text-5xl font-bold tracking-tight text-brand-ink">timo – Zeit &amp; Rechnungen</h1>
          <p class="mt-5 text-lg text-brand-muted leading-relaxed max-w-xl">
            Die Zeiterfassung für Selbständige in der Schweiz: vom Timer bis zur bezahlten QR-Rechnung. Auf iPhone, iPad und Mac – ohne Konto, deine Daten bleiben bei dir.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <span class="inline-flex items-center px-5 py-3 rounded-xl bg-brand-accent text-white font-semibold">Bald im App Store</span>
            <a href="#support" class="inline-flex items-center px-5 py-3 rounded-xl bg-brand-soft text-brand-accent font-semibold hover:bg-[#dcefe3] transition-colors">Hilfe &amp; Kontakt</a>
          </div>
        </div>
        <div class="flex justify-center gap-4 sm:gap-6">
          <img src="/timo/2-time.jpg" alt="timo auf dem iPhone: laufender Timer mit Kunde, Projekt und Notiz" width="1000" height="2173" class="w-[44%] max-w-[240px] h-auto rounded-[28px] border border-brand-border shadow-window" />
          <img src="/timo/5-invoice-pdf.jpg" alt="timo auf dem iPhone: Rechnung als PDF mit Swiss QR-Zahlteil" width="1000" height="2173" class="w-[44%] max-w-[240px] h-auto rounded-[28px] border border-brand-border shadow-window mt-10" />
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="funktionen" class="px-4 sm:px-6">
      <div class="max-w-6xl mx-auto py-16 sm:py-20">
        <h2 class="text-3xl font-bold text-brand-ink">Was timo kann</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {features.map((f) => (
            <div class="rounded-rail bg-white border border-brand-border p-6">
              <h3 class="text-lg font-semibold text-brand-ink">{f.title}</h3>
              <ul class="mt-4 space-y-3">
                {f.items.map((item) => (
                  <li class="flex gap-3 text-sm text-brand-muted leading-relaxed">
                    <span aria-hidden="true" class="mt-[7px] w-1.5 h-1.5 shrink-0 rounded-full bg-brand-sage"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="mt-8 text-sm text-brand-muted max-w-3xl leading-relaxed">
          <strong class="text-brand-ink">Deine Daten:</strong> kein Konto, kein Tracking, keine Werbung. Alles bleibt auf deinen Geräten und wird über dein eigenes iCloud abgeglichen. Mehr dazu in der <a href="/timo/legal#datenschutz" class="text-brand-accent hover:underline">Datenschutzerklärung</a>.
        </p>
      </div>
    </section>

    <!-- Pricing -->
    <section id="preise" class="px-4 sm:px-6 bg-white border-y border-brand-border">
      <div class="max-w-4xl mx-auto py-16 sm:py-20">
        <h2 class="text-3xl font-bold text-brand-ink">Gratis starten, Pro wenn du es brauchst</h2>
        <p class="mt-4 text-brand-muted leading-relaxed">
          timo Pro gibt es im Abo: <strong class="text-brand-ink">CHF 50.– pro Jahr</strong> (zwei Monate gratis) oder <strong class="text-brand-ink">CHF 5.– pro Monat</strong>. Es gilt auf all deinen Geräten und ist jederzeit kündbar.
        </p>
        <div class="mt-8 overflow-x-auto rounded-rail border border-brand-border">
          <table class="w-full text-sm">
            <thead class="bg-brand-soft text-brand-ink">
              <tr>
                <th scope="col" class="text-left font-semibold px-4 py-3"><span class="sr-only">Funktion</span></th>
                <th scope="col" class="font-semibold px-4 py-3 w-28">Gratis</th>
                <th scope="col" class="font-semibold px-4 py-3 w-28">timo Pro</th>
              </tr>
            </thead>
            <tbody>
              {plans.map((p) => (
                <tr class="border-t border-brand-border">
                  <th scope="row" class="text-left font-normal text-brand-ink px-4 py-3">{p.label}</th>
                  <td class="text-center text-brand-muted px-4 py-3">{p.free}</td>
                  <td class="text-center text-brand-accent font-semibold px-4 py-3">{p.pro}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-xs text-brand-muted">Preise in Schweizer Franken inkl. MWST, bezahlt über den App Store. Das Abo verlängert sich automatisch, wenn du es nicht spätestens 24 Stunden vor Ablauf kündigst. Bestehende Rechnungen und Daten bleiben immer verfügbar, auch ohne Pro.</p>
      </div>
    </section>

    <!-- Support -->
    <section id="support" class="px-4 sm:px-6">
      <div class="max-w-4xl mx-auto py-16 sm:py-20">
        <h2 class="text-3xl font-bold text-brand-ink">Hilfe &amp; Kontakt</h2>
        <div class="mt-8 space-y-3">
          {faq.map((item) => (
            <details class="group rounded-card bg-white border border-brand-border px-5 py-4">
              <summary class="cursor-pointer list-none flex items-center justify-between gap-4 font-semibold text-brand-ink">
                {item.q}
                <span aria-hidden="true" class="text-brand-muted transition-transform group-open:rotate-45 text-xl leading-none">+</span>
              </summary>
              <p class="mt-3 text-sm text-brand-muted leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>
        <div class="mt-10 rounded-rail bg-brand-soft p-6 sm:p-8">
          <h3 class="text-lg font-semibold text-brand-ink">Frage, Fehler oder Wunsch?</h3>
          <p class="mt-2 text-sm text-brand-muted leading-relaxed">
            Schreib an <a href={`mailto:${supportMail}?subject=timo`} class="text-brand-accent font-semibold hover:underline">{supportMail}</a>. Nenne am besten dein Gerät (iPhone, iPad oder Mac) und was du gerade gemacht hast.
          </p>
        </div>
        <p class="mt-10 text-xs text-brand-muted leading-relaxed">
          Anbieter von timo: J.Huser IT Services, Abläschstrasse 66, 8750 Glarus, Schweiz ·
          <a href="/timo/legal" class="text-brand-accent hover:underline">Impressum &amp; Datenschutz</a> ·
          <a href="https://www.apple.com/legal/internet-services/itunes/dev/stdeula/" class="text-brand-accent hover:underline">Nutzungsbedingungen (Apple-Standard-EULA)</a>
        </p>
      </div>
    </section>
  </main>
  <TimoFooter />
</Base>

---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Legal & Privacy — Froggi" description="Legal information and privacy policy for Froggi.">
  <Nav />
  <main class="pt-[72px]">
    <div class="max-w-3xl mx-auto px-6 py-24">
      <h1 class="text-4xl font-bold text-brand-text mb-4">Legal &amp; Privacy</h1>
      <p class="text-brand-muted mb-12">Last updated: March 2026</p>

      <!-- Imprint -->
      <section class="mb-12">
        <h2 class="text-xl font-semibold text-brand-text mb-4 pb-2 border-b border-brand-border">Imprint</h2>
        <div class="text-brand-muted text-sm leading-relaxed space-y-2">
          <p class="text-brand-text font-medium">Froggi</p>
          <p>Switzerland</p>
          <p>
            Email:{' '}
            <a href="mailto:hello@froggi.ch" class="text-brand-emerald hover:underline">hello@froggi.ch</a>
          </p>
        </div>
      </section>

      <!-- Privacy -->
      <section class="mb-12">
        <h2 class="text-xl font-semibold text-brand-text mb-4 pb-2 border-b border-brand-border">Privacy Policy</h2>
        <div class="text-brand-muted text-sm leading-relaxed space-y-4">
          <p>
            We take the privacy of our users seriously. This page will be updated with our full privacy policy shortly.
          </p>
          <p>
            <strong class="text-brand-text">Data collected on this website:</strong> When you submit the contact form, your name, email address, and message are sent to us via Formspree. We use this information solely to respond to your enquiry and will not share it with third parties.
          </p>
          <p>
            <strong class="text-brand-text">Cookies:</strong> This promotional website does not set any tracking cookies.
          </p>
          <p>
            <strong class="text-brand-text">Hosting:</strong> This website is hosted on our own infrastructure in Switzerland.
          </p>
          <p>
            For any data protection enquiries, please contact us at{' '}
            <a href="mailto:hello@froggi.ch" class="text-brand-emerald hover:underline">hello@froggi.ch</a>.
          </p>
        </div>
      </section>

      <!-- Disclaimer -->
      <section>
        <h2 class="text-xl font-semibold text-brand-text mb-4 pb-2 border-b border-brand-border">Disclaimer</h2>
        <p class="text-brand-muted text-sm leading-relaxed">
          The information on this website is provided for general informational purposes only. While we strive to keep it accurate and up to date, we make no representations or warranties of any kind about the completeness, accuracy, or suitability of the information. Use of this website is at your own risk.
        </p>
      </section>
    </div>
  </main>
  <Footer />
</Base>

---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Rechtliches & Datenschutz — Froggi" description="Rechtliche Informationen und Datenschutzerklärung für Froggi.">
  <Nav />
  <main class="pt-[54px]">
    <div class="max-w-3xl mx-auto px-6 py-24">
      <h1 class="text-4xl font-bold text-brand-text mb-4">Rechtliches &amp; Datenschutz</h1>
      <p class="text-brand-muted mb-12">Zuletzt aktualisiert: März 2026</p>

      <!-- Impressum -->
      <section class="mb-12">
        <h2 class="text-xl font-semibold text-brand-text mb-4 pb-2 border-b border-brand-border">Impressum</h2>
        <div class="text-brand-muted text-sm leading-relaxed space-y-2">
          <p class="text-brand-text font-medium">Froggi</p>
          <p>Schweiz</p>
          <p>
            E-Mail:{' '}
            <a href="mailto:hello@froggi.ch" class="text-brand-accent hover:underline">hello@froggi.ch</a>
          </p>
        </div>
      </section>

      <!-- Datenschutz -->
      <section class="mb-12">
        <h2 class="text-xl font-semibold text-brand-text mb-4 pb-2 border-b border-brand-border">Datenschutzerklärung</h2>
        <div class="text-brand-muted text-sm leading-relaxed space-y-4">
          <p>
            Der Schutz Ihrer Daten ist uns ein wichtiges Anliegen. Diese Seite wird in Kürze mit unserer vollständigen Datenschutzerklärung aktualisiert.
          </p>
          <p>
            <strong class="text-brand-text">Auf dieser Website erhobene Daten:</strong> Wenn Sie das Kontaktformular absenden, werden Ihr Name, Ihre E-Mail-Adresse, Ihre Organisation (falls angegeben) und Ihre Nachricht über den Dienst Web3Forms per E-Mail an uns übermittelt. Wir verwenden diese Informationen ausschliesslich zur Beantwortung Ihrer Anfrage und geben sie nicht an Dritte weiter.
          </p>
          <p>
            <strong class="text-brand-text">Cookies:</strong> Diese Promotionswebsite setzt keine Tracking-Cookies.
          </p>
          <p>
            <strong class="text-brand-text">Hosting:</strong> Diese Website wird auf unserer eigenen Infrastruktur in der Schweiz gehostet.
          </p>
          <p>
            Bei Fragen zum Datenschutz wenden Sie sich bitte an{' '}
            <a href="mailto:hello@froggi.ch" class="text-brand-accent hover:underline">hello@froggi.ch</a>.
          </p>
        </div>
      </section>

      <!-- Haftungsausschluss -->
      <section>
        <h2 class="text-xl font-semibold text-brand-text mb-4 pb-2 border-b border-brand-border">Haftungsausschluss</h2>
        <p class="text-brand-muted text-sm leading-relaxed">
          Die Informationen auf dieser Website dienen ausschliesslich allgemeinen Informationszwecken. Obwohl wir uns bemühen, die Inhalte aktuell und korrekt zu halten, übernehmen wir keine Gewähr für die Vollständigkeit, Richtigkeit oder Eignung der bereitgestellten Informationen. Die Nutzung dieser Website erfolgt auf eigene Verantwortung.
        </p>
      </section>
    </div>
  </main>
  <Footer />
</Base>

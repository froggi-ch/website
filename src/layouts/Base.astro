---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Froggi — Plattform für Gesundheitsmanagement',
  description = 'Froggi ist die modulare Plattform für Pflegeteams – Berichte, Zeitachsen, Medikamente, Audit-Trail und mehr. Auf jedem Gerät.',
} = Astro.props;
---

<!doctype html>
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/app-icon.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Inter font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      html {
        font-family: 'Inter', system-ui, sans-serif;
      }
      /* Smooth scroll offset for sticky nav */
      :target {
        scroll-margin-top: 72px;
      }
    </style>
  </head>
  <body class="bg-brand-bg text-brand-text antialiased">
    <slot />
  </body>
</html>

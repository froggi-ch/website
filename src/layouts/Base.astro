---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Froggi — Dokumentation für Teams im Einsatz',
  description = 'Froggi ist die Dokumentationsplattform für Pflege, Liegenschaften und Unterhalt: eigene Formulare, Erfassung im Web und offline auf dem Handy, Verlauf und Aufgaben pro Objekt.',
} = Astro.props;
---

<!doctype html>
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f9f7" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/froggi-frog.svg" />

    <link rel="icon" type="image/svg+xml" href="/froggi-frog.svg" />

    <style is:global>
      /* The app's own stack (corev2 web/src/styles.css): no web font. */
      html {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      }
      /* Anchor targets clear the sticky nav. */
      :target {
        scroll-margin-top: 80px;
      }
      ::selection {
        background: #a2cdab;
        color: #15231b;
      }
    </style>
  </head>
  <body class="bg-brand-bg text-brand-text antialiased">
    <slot />
  </body>
</html>

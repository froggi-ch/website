---
const modules = [
  {
    title: 'Berichtsmodul',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />',
    description: 'Erstellen Sie strukturierte Datenerfassungsformulare aus wiederverwendbaren Vorlagen. Standardisieren Sie, wie Mitarbeitende Beobachtungen, Beurteilungen und Pflegeereignisse erfassen – mit vollständiger Kategorie- und Aktionskonfiguration, ohne eine Zeile Code.',
  },
  {
    title: 'Zeitachsenmodul',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />',
    description: 'Jedes Ereignis, in chronologischer Reihenfolge. Filtern Sie nach Zeitraum, Kategorie oder Mitarbeitenden, um genau zu sehen, was wann geschehen ist – ideal für Übergaben, Vorfallsanalysen und die Pflegekontinuität.',
  },
  {
    title: 'Diagrammmodul',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />',
    description: 'Verwandeln Sie erfasste Berichtsdaten in Trenddiagramme und zeitaggregierte Dashboards. Erkennen Sie Muster frühzeitig, verfolgen Sie Ergebnisse über Zeit – ganz ohne Tabellenexport.',
  },
  {
    title: 'Medikamentenmodul',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />',
    description: 'Verwalten Sie Medikamentenpläne, Dosierungen und Verabreichungsnachweise pro Patientin und Patient. Strukturierte Arbeitsabläufe für Vorbereitung, Verabreichung und Nachbereitung reduzieren Fehler und fördern die Verantwortlichkeit.',
  },
  {
    title: 'Audit-Trail',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />',
    description: 'Jeder Schreibvorgang wird protokolliert, mit Zeitstempel versehen und in einer unveränderlichen Hash-Kette verknüpft. Audit-Einträge können nicht rückwirkend geändert werden – vollständige Nachverfolgung jeder Datenänderung, Compliance-konform ab der ersten Minute.',
  },
  {
    title: 'Erinnerungen',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />',
    description: 'Konfigurieren Sie periodenbasierte Erinnerungen mit benutzerdefinierten Bedingungen und Bezeichnungen – täglich, wöchentlich oder in individuellen Intervallen. Wiederkehrende Aufgaben und Pflegechecks werden nie vergessen, unabhängig vom Schichtwechsel.',
  },
];
---

<section id="modules" class="py-24 px-6 bg-brand-surface/30">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <span class="inline-block text-brand-emerald text-sm font-semibold uppercase tracking-widest mb-3">Module</span>
      <h2 class="text-3xl md:text-4xl font-bold text-brand-text">Entwickelt für jeden Arbeitsablauf</h2>
      <p class="mt-4 text-brand-muted max-w-xl mx-auto">
        Jedes Modul ist unabhängig konfigurierbar und integriert sich nahtlos in den Rest der Plattform.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {modules.map((m) => (
        <div class="flex gap-5 bg-brand-surface rounded-xl p-6 border border-brand-border hover:border-brand-emerald/30 transition-colors duration-200 border-l-2 border-l-brand-emerald">
          <div class="shrink-0 w-10 h-10 rounded-lg bg-brand-emerald/10 flex items-center justify-center mt-0.5">
            <svg class="w-5 h-5 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <Fragment set:html={m.icon} />
            </svg>
          </div>
          <div>
            <h3 class="text-base font-semibold text-brand-text mb-2">{m.title}</h3>
            <p class="text-sm text-brand-muted leading-relaxed">{m.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

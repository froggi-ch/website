---
import Icon from './Icon.astro';

// The close of every page: one call to action, with a second, quieter path.
export interface Props {
  title?: string;
  text?: string;
  secondary?: { label: string; href: string };
}
const {
  title = 'Mach den Sprung.',
  text = 'Wir zeigen Ihnen Froggi mit Ihren eigenen Abläufen – online oder vor Ort.',
  secondary = { label: 'Preise ansehen', href: '/preise' },
} = Astro.props;
---

<section class="py-20 md:py-24 border-t border-brand-border">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="relative overflow-hidden rounded-[24px] bg-brand-accent-dark text-white px-6 py-12 sm:px-12 md:py-14 flex flex-col md:flex-row md:items-center gap-8 md:gap-12">
      <div class="absolute -right-24 -top-24 w-[380px] h-[380px] rounded-full opacity-[0.12] pointer-events-none" style="background: radial-gradient(circle, #a2cdab, transparent 70%);"></div>
      <img src="/froggi-frog.svg" alt="" width="64" height="64" class="relative shrink-0 hidden sm:block" />
      <div class="relative flex-1">
        <h2 class="text-2xl md:text-3xl font-bold tracking-[-0.02em]">{title}</h2>
        <p class="mt-2 text-white/75 leading-relaxed max-w-xl">{text}</p>
      </div>
      <div class="relative flex flex-col sm:flex-row gap-3 shrink-0">
        <a href="/kontakt" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-card bg-white text-brand-accent-dark font-semibold hover:bg-brand-soft transition-colors">
          Demo anfragen <Icon name="arrow" class="w-4 h-4" stroke={2} />
        </a>
        <a href={secondary.href} class="inline-flex items-center justify-center px-5 py-3 rounded-card border border-white/30 text-white font-medium hover:bg-white/10 transition-colors">
          {secondary.label}
        </a>
      </div>
    </div>
  </div>
</section>

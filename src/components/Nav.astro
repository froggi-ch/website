---
const links = [
  { label: 'Funktionen', href: '#features' },
  { label: 'Module', href: '#modules' },
  { label: 'Plattform', href: '#platform' },
  { label: 'Sicherheit', href: '#security' },
  { label: 'Kontakt', href: '#contact' },
];
---

<nav
  id="nav"
  class="fixed top-0 inset-x-0 z-50 transition-colors duration-300 bg-brand-bg/80 backdrop-blur-md border-b border-brand-border/40"
>
  <div class="max-w-6xl mx-auto px-6 h-[72px] flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <img
        src="/app-icon.png"
        alt="Froggi logo"
        width="36"
        height="36"
        class="rounded-lg"
      />
      <span class="text-lg font-bold tracking-tight text-brand-text group-hover:text-brand-emerald transition-colors">
        Froggi
      </span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-8">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class="text-sm font-medium text-brand-muted hover:text-brand-text transition-colors"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA -->
    <a
      href="#contact"
      class="hidden md:inline-flex items-center px-4 py-2 rounded-lg bg-brand-emerald text-white text-sm font-semibold hover:bg-brand-emerald-dark transition-colors"
    >
      Demo anfragen
    </a>

    <!-- Mobile hamburger (CSS-only) -->
    <label for="nav-toggle" class="md:hidden cursor-pointer p-2 text-brand-muted hover:text-brand-text transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </label>
  </div>

  <!-- Mobile menu (CSS-only toggle) -->
  <input type="checkbox" id="nav-toggle" class="hidden peer" />
  <div class="peer-checked:flex hidden md:hidden flex-col gap-2 px-6 pb-4 border-t border-brand-border/40 bg-brand-bg">
    {links.map((l) => (
      <a
        href={l.href}
        class="py-2 text-sm font-medium text-brand-muted hover:text-brand-text transition-colors"
      >
        {l.label}
      </a>
    ))}
    <a
      href="#contact"
      class="mt-2 inline-flex justify-center items-center px-4 py-2 rounded-lg bg-brand-emerald text-white text-sm font-semibold hover:bg-brand-emerald-dark transition-colors"
    >
      Demo anfragen
    </a>
  </div>
</nav>

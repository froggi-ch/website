---
// The app's top bar, as a website nav: white, the frog with its wordmark in
// accent-dark, and pill links — the current page's pill filled, as the app
// marks its active tab (corev2 .topbar nav a.active).
const links = [
  { label: 'Produkt', href: '/produkt' },
  { label: 'Funktionen', href: '/funktionen' },
  { label: 'KI', href: '/ki' },
  { label: 'Preise', href: '/preise' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = (href: string) => path === href;
---

<nav class="fixed top-0 inset-x-0 z-50 bg-white/90 backdrop-blur-md border-b border-brand-border">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-[54px] flex items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2 text-[1.1rem] font-bold text-brand-accent-dark">
      <img src="/froggi-frog.svg" alt="" width="26" height="26" />
      Froggi
    </a>

    <ul class="hidden md:flex items-center gap-1 mr-auto">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            aria-current={active(l.href) ? 'page' : undefined}
            class={`px-3 py-1.5 rounded-lg text-[0.94rem] transition-colors ${active(l.href) ? 'bg-brand-soft text-brand-accent font-semibold' : 'text-brand-ink hover:bg-brand-soft hover:text-brand-accent'}`}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href="/kontakt"
      class="hidden md:inline-flex items-center px-4 py-1.5 rounded-lg bg-brand-accent text-white text-[0.94rem] font-medium hover:bg-brand-accent-dark transition-colors"
    >
      Demo anfragen
    </a>

    <label for="nav-toggle" class="md:hidden cursor-pointer p-2 -mr-2 text-brand-muted hover:text-brand-ink" aria-label="Menü">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </label>
  </div>

  <input type="checkbox" id="nav-toggle" class="hidden peer" />
  <div class="peer-checked:flex hidden md:hidden flex-col gap-1 px-4 pb-4 border-t border-brand-border bg-white">
    {links.map((l) => (
      <a href={l.href} class={`py-2 px-2 rounded-lg text-sm ${active(l.href) ? 'bg-brand-soft text-brand-accent font-semibold' : 'font-medium text-brand-ink'}`}>{l.label}</a>
    ))}
    <a href="/kontakt" class="mt-2 inline-flex justify-center px-4 py-2 rounded-lg bg-brand-accent text-white text-sm font-semibold">
      Demo anfragen
    </a>
  </div>
</nav>

---
// A device frame around a real screenshot of the Flutter app (from
// marketing/app-store/raw, downscaled into public/screens). Real screens, not
// a drawing, so the phone can never drift from what the app shows.
export interface Props {
  screen?: '01-objekt' | '02-aktion' | '03-details' | '04-verlauf' | '05-aufgaben';
  alt?: string;
  class?: string;
}
const { screen = '05-aufgaben', alt = '', class: className = 'w-[240px]' } = Astro.props;
---

<div class={`rounded-[38px] bg-brand-ink p-[7px] shadow-window select-none ${className}`}>
  <div class="relative rounded-[31px] overflow-hidden bg-brand-bg aspect-[1320/2868]">
    <img src={`/screens/${screen}.jpg`} alt={alt} width="660" height="1434" loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
    <span class="absolute top-[1.6%] left-1/2 -translate-x-1/2 w-[30%] h-[3.2%] rounded-full bg-brand-ink"></span>
  </div>
</div>

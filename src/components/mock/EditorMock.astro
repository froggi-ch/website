---
import AppWindow from './AppWindow.astro';
import Icon from '../Icon.astro';

const tree = [
  { label: 'Unterhalt', depth: 0, kind: 'Kategorie' },
  { label: 'Störungsmeldung', depth: 1, kind: 'Aktion', active: true },
  { label: 'Reinigungskontrolle', depth: 1, kind: 'Aktion' },
  { label: 'Vermietung', depth: 0, kind: 'Kategorie' },
  { label: 'Wohnungsübergabe', depth: 1, kind: 'Aktion' },
  { label: 'Wohnungsabnahme', depth: 1, kind: 'Aktion' },
];

const fields = [
  { label: 'Art der Störung', type: 'Auswahl', icon: 'check' },
  { label: 'Anlagendruck (bar)', type: 'Zahl', icon: 'thermo', rule: true },
  { label: 'Fotos', type: 'Bild', icon: 'camera', rule: true },
  { label: 'Standort', type: 'Standort', icon: 'pin' },
  { label: 'Bemerkung', type: 'Freitext', icon: 'editor' },
];
---

<AppWindow active="Reporteditor">
  <div class="grid sm:grid-cols-[150px_1fr] gap-3 p-3">
    <div class="hidden sm:block rounded-xl bg-white border border-brand-border p-2">
      {tree.map((t) => (
        <div
          class={`py-1 rounded-md text-[10.5px] ${t.depth === 0 ? 'font-semibold text-brand-ink mt-1' : ''} ${t.active ? 'bg-brand-soft text-brand-accent font-semibold' : ''}`}
          style={`padding-left:${t.depth * 12 + 6}px`}
        >{t.label}</div>
      ))}
    </div>
    <div class="min-w-0">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-[13px] font-bold">Störungsmeldung</span>
        <span class="text-[9px] px-1.5 py-0.5 rounded bg-brand-soft text-brand-accent font-semibold">Revision 4</span>
      </div>
      <div class="space-y-1.5">
        {fields.map((f) => (
          <div class="rounded-lg bg-white border border-brand-border px-2.5 py-1.5">
            <div class="flex items-center gap-2">
              <Icon name={f.icon} class="w-3.5 h-3.5 text-brand-accent" />
              <span class="text-[10.5px] font-medium flex-1 truncate">{f.label}</span>
              <span class="text-[9px] text-brand-muted">{f.type}</span>
            </div>
            {f.rule && (
              <div class="mt-1 pl-[22px] flex items-center gap-1 text-[9px] text-brand-muted">
                <Icon name="eye" class="w-3 h-3" /> sichtbar, wenn <span class="text-brand-ink font-medium">Art der Störung = Druckverlust</span>
              </div>
            )}
          </div>
        ))}
      </div>
      <div class="mt-2 flex gap-1 text-[9px] text-brand-muted">
        <span class="px-1.5 py-0.5 rounded border border-brand-border bg-white">DE</span>
        <span class="px-1.5 py-0.5 rounded border border-brand-border bg-white">FR</span>
        <span class="px-1.5 py-0.5 rounded border border-brand-border bg-white">IT</span>
        <span class="px-1.5 py-0.5 rounded border border-brand-border bg-white">EN</span>
      </div>
    </div>
  </div>
</AppWindow>

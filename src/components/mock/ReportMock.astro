---
import AppWindow from './AppWindow.astro';
import Icon from '../Icon.astro';

// Step 3 of the report flow as v2 draws it (corev2 .stepper, .chip-group): a
// visibility rule has just revealed the follow-up fields.
const steps = ['Objekt', 'Aktion', 'Details'];
const chipOn = 'bg-[#d6eadb] text-brand-accent-dark border-transparent';
const chipOff = 'bg-white border-brand-border';
---

<AppWindow active="Erfassen">
  <div class="px-4 py-4 max-w-[400px] mx-auto">
    <ol class="flex mb-4">
      {steps.map((s, i) => (
        <li class="relative flex-1 flex justify-center">
          {i > 0 && <span class="absolute top-[11px] -left-1/2 right-1/2 mx-4 border-t-2 border-dashed border-brand-border"></span>}
          <span class="relative flex flex-col items-center gap-1">
            <span class={`w-6 h-6 rounded-full flex items-center justify-center text-[10px] font-bold ${i < 2 ? 'bg-brand-soft text-brand-accent' : 'bg-brand-accent text-white'}`}>
              {i < 2 ? <Icon name="check" class="w-3 h-3" stroke={2.6} /> : i + 1}
            </span>
            <span class={`text-[9px] font-semibold ${i === 2 ? 'text-brand-ink' : 'text-brand-muted'}`}>{s}</span>
          </span>
        </li>
      ))}
    </ol>

    <div class="text-[13px] font-bold text-brand-ink">Störungsmeldung · Heizung – Gaskessel</div>
    <div class="text-[9.5px] text-brand-muted mb-3">Erfassen Sie die Details zur ausgewählten Aktion.</div>

    <div class="space-y-3">
      <div>
        <div class="text-[10.5px] font-semibold mb-1.5">Art der Störung <span class="text-brand-danger">*</span> <span class="font-normal text-brand-muted">(eine auswählen)</span></div>
        <div class="flex flex-wrap gap-1.5 text-[10px]">
          <span class={`px-2.5 py-1 rounded-lg border ${chipOn}`}>Druckverlust</span>
          <span class={`px-2.5 py-1 rounded-lg border ${chipOff}`}>Kein Warmwasser</span>
          <span class={`px-2.5 py-1 rounded-lg border ${chipOff}`}>Geräusche</span>
        </div>
      </div>

      <div class="rounded-card bg-white border border-brand-border p-2.5 space-y-2.5">
        <div class="flex items-center gap-1 text-[9px] text-brand-muted"><Icon name="eye" class="w-3 h-3" /> Sichtbar, weil «Druckverlust» gewählt ist</div>
        <div>
          <div class="flex justify-between text-[10.5px] font-semibold mb-1.5"><span>Anlagendruck (bar)</span><span class="text-brand-accent tabular-nums">1.1</span></div>
          <div class="relative h-1.5 rounded-full bg-brand-border">
            <div class="absolute inset-y-0 left-0 w-[37%] rounded-full bg-brand-accent"></div>
            <div class="absolute top-1/2 left-[37%] -translate-x-1/2 -translate-y-1/2 w-3.5 h-3.5 rounded-full bg-white border-2 border-brand-accent"></div>
          </div>
        </div>
        <div>
          <div class="text-[10.5px] font-semibold mb-1.5">Kontrolliert <span class="font-normal text-brand-muted">(beliebige auswählen)</span></div>
          <div class="flex flex-wrap gap-1.5 text-[10px]">
            <span class={`inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border ${chipOn}`}><Icon name="check" class="w-2.5 h-2.5" stroke={2.6} />Ausdehnungsgefäss</span>
            <span class={`px-2.5 py-1 rounded-lg border ${chipOff}`}>Sicherheitsventil</span>
            <span class={`inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border ${chipOn}`}><Icon name="check" class="w-2.5 h-2.5" stroke={2.6} />Leitungen</span>
          </div>
        </div>
        <div class="flex gap-2">
          <div class="w-14 h-11 rounded-lg bg-gradient-to-br from-[#c9d6cd] to-[#8fa596] flex items-center justify-center text-white"><Icon name="camera" class="w-4 h-4" /></div>
          <div class="w-14 h-11 rounded-lg border border-dashed border-brand-sage flex items-center justify-center text-brand-accent"><Icon name="plus" class="w-4 h-4" /></div>
        </div>
      </div>

      <div class="flex items-center gap-1.5 text-[9.5px] text-brand-muted">
        <Icon name="pin" class="w-3.5 h-3.5 text-brand-accent" /> Standort erfasst · 47.050, 8.309
      </div>
    </div>

    <div class="flex gap-2 mt-3.5">
      <span class="px-4 py-1.5 rounded-lg border border-brand-ink/60 text-brand-accent text-[11px]">Zurück</span>
      <span class="flex-1 text-center py-1.5 rounded-lg bg-brand-accent text-white text-[11px] font-semibold">Ereignis speichern</span>
    </div>
  </div>
</AppWindow>

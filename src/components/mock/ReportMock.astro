---
import AppWindow from './AppWindow.astro';
import Icon from '../Icon.astro';

// Step 3 of the report flow: the form an action describes, with a visibility
// rule having just revealed the follow-up fields.
const steps = ['Objekt', 'Aktion', 'Details'];
---

<AppWindow active="Erfassen">
  <div class="px-4 py-4 max-w-[420px] mx-auto">
    <div class="flex items-center justify-between mb-4 px-4">
      {steps.map((s, i) => (
        <>
          <div class="flex flex-col items-center gap-1">
            <span class={`w-6 h-6 rounded-full flex items-center justify-center text-[10px] font-semibold ${i < 2 ? 'bg-brand-accent text-white' : 'bg-brand-accent text-white ring-4 ring-brand-soft'}`}>
              {i < 2 ? <Icon name="check" class="w-3 h-3" stroke={2.5} /> : i + 1}
            </span>
            <span class="text-[9px] text-brand-ink">{s}</span>
          </div>
          {i < 2 && <div class="flex-1 h-px bg-brand-accent/40 mx-2 -mt-3"></div>}
        </>
      ))}
    </div>
    <div class="text-[10px] text-brand-muted">Heizung – Gaskessel</div>
    <div class="text-[14px] font-bold text-brand-ink mb-3">Störungsmeldung</div>

    <div class="space-y-3 rounded-xl bg-white border border-brand-border p-3">
      <div>
        <div class="text-[10px] font-semibold mb-1.5">Art der Störung</div>
        <div class="flex flex-wrap gap-1.5">
          <span class="px-2.5 py-1 rounded-full text-[10px] bg-brand-accent text-white">Druckverlust</span>
          <span class="px-2.5 py-1 rounded-full text-[10px] border border-brand-border">Kein Warmwasser</span>
          <span class="px-2.5 py-1 rounded-full text-[10px] border border-brand-border">Geräusche</span>
        </div>
      </div>
      <div class="rounded-lg bg-brand-soft/60 border border-brand-sage/50 p-2.5 space-y-2.5">
        <div>
          <div class="flex justify-between text-[10px] font-semibold mb-1"><span>Anlagendruck (bar)</span><span class="text-brand-accent">1.1</span></div>
          <div class="relative h-1.5 rounded-full bg-brand-border">
            <div class="absolute inset-y-0 left-0 w-[37%] rounded-full bg-brand-accent"></div>
            <div class="absolute top-1/2 left-[37%] -translate-x-1/2 -translate-y-1/2 w-3.5 h-3.5 rounded-full bg-white border-2 border-brand-accent"></div>
          </div>
        </div>
        <div class="flex gap-2">
          <div class="w-14 h-11 rounded-md bg-gradient-to-br from-[#c9d6cd] to-[#8fa596] flex items-center justify-center text-white"><Icon name="camera" class="w-4 h-4" /></div>
          <div class="w-14 h-11 rounded-md border border-dashed border-brand-sage flex items-center justify-center text-brand-accent text-[16px]">+</div>
        </div>
      </div>
      <div class="flex items-center gap-1.5 text-[10px] text-brand-muted">
        <Icon name="pin" class="w-3.5 h-3.5 text-brand-accent" /> Standort erfasst · 47.050, 8.309
      </div>
    </div>
    <div class="flex justify-end mt-3">
      <span class="px-4 py-1.5 rounded-lg bg-brand-accent text-white text-[11px] font-semibold">Speichern</span>
    </div>
  </div>
</AppWindow>

---
import AppWindow from './AppWindow.astro';
import Icon from '../Icon.astro';

// The history as v2 draws it (corev2 .timeline-*): a day heading with its
// tile, then a time column and a dot on the rail beside each report.
const days = [
  {
    day: 'Heute — 15. Okt.',
    items: [
      { time: '16:42', action: 'Störungsmeldung', obj: 'Heizung – Gaskessel', who: 'R. Meier', icon: 'wrench', tone: 'bg-tone-red-bg text-tone-red', photos: 2, now: true },
      { time: '11:05', action: 'Reinigungskontrolle', obj: 'Treppenhaus A', who: 'A. Rossi', icon: 'sparkle', tone: 'bg-tone-violet-bg text-tone-violet' },
    ],
  },
  {
    day: 'Gestern — 14. Okt.',
    items: [
      { time: '18:56', action: 'Rundgang Aussenanlage', obj: 'Bahnhofstrasse 12', who: 'M. Keller', icon: 'leaf', tone: 'bg-tone-green-bg text-tone-green' },
      { time: '09:20', action: 'Wohnungsübergabe', obj: 'Whg. 201 – 3.5 Zi.', who: 'M. Keller', icon: 'door', tone: 'bg-tone-blue-bg text-tone-blue', photos: 6 },
    ],
  },
];
---

<AppWindow active="Verlauf">
  <div class="p-3.5">
    <div class="rounded-card bg-white border border-brand-border p-2.5 space-y-2">
      <div class="flex gap-2">
        <div class="flex-1 flex items-center gap-1.5 h-7 rounded-lg border border-brand-border px-2.5 text-[10.5px] text-brand-muted">
          <Icon name="search" class="w-3 h-3" /> Berichte durchsuchen…
        </div>
        <div class="h-7 rounded-lg border border-brand-ink/70 px-2.5 text-[10.5px] flex items-center gap-1.5">
          <Icon name="calendar" class="w-3 h-3" /> Letzte 7 Tage
        </div>
      </div>
      <div class="flex flex-wrap gap-1.5 text-[10px]">
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full border border-brand-border"><Icon name="cube" class="w-2.5 h-2.5 text-brand-muted" />Alle Objekte</span>
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full border border-brand-border"><Icon name="clipboard" class="w-2.5 h-2.5 text-brand-muted" />Alle Aktionen</span>
      </div>
    </div>

    {days.map((d) => (
      <div>
        <div class="flex items-center gap-2 mt-3.5 mb-2 text-[11.5px] font-bold">
          <span class="w-5 h-5 rounded-md flex items-center justify-center bg-brand-soft text-brand-accent"><Icon name="calendar" class="w-3 h-3" /></span>
          {d.day}
        </div>
        <div class="relative space-y-1.5">
          <div class="absolute left-[9px] top-3 bottom-3 border-l-2 border-brand-border"></div>
          {d.items.map((i) => (
            <div class="relative grid grid-cols-[20px_34px_minmax(0,1fr)] gap-2 items-start">
              <span class={`relative z-10 justify-self-center mt-[15px] w-2 h-2 rounded-full border-2 border-brand-accent ring-[3px] ring-brand-bg ${i.now ? 'bg-brand-accent' : 'bg-white'}`}></span>
              <span class="mt-3 text-[9.5px] tabular-nums text-brand-muted">{i.time}</span>
              <div class="flex items-center gap-2 rounded-card bg-white border border-brand-border px-2.5 py-2">
                <span class={`w-7 h-7 rounded-lg flex items-center justify-center shrink-0 ${i.tone}`}><Icon name={i.icon} class="w-3.5 h-3.5" /></span>
                <div class="min-w-0 flex-1 leading-tight">
                  <div class="text-[11px] font-semibold truncate">{i.action}</div>
                  <div class="mt-0.5 text-[9.5px] text-brand-muted truncate">{i.obj} · {i.who}</div>
                </div>
                {i.photos && (
                  <span class="inline-flex items-center gap-1 text-[9px] text-brand-muted"><Icon name="camera" class="w-3 h-3" />{i.photos}</span>
                )}
                <Icon name="chevron" class="w-3 h-3 text-brand-muted" />
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</AppWindow>

---
import AppWindow from './AppWindow.astro';
import Icon from '../Icon.astro';

const days = [
  {
    day: 'Heute – 9. Okt.',
    items: [
      { time: '16:42', action: 'Störungsmeldung', obj: 'Heizung – Gaskessel', who: 'r.meier', icon: 'wrench', tone: 'bg-red-50 text-red-600', photo: true },
      { time: '11:05', action: 'Reinigungskontrolle', obj: 'Treppenhaus A', who: 'a.rossi', icon: 'sparkle', tone: 'bg-violet-50 text-violet-600' },
    ],
  },
  {
    day: 'Gestern – 8. Okt.',
    items: [
      { time: '18:56', action: 'Aussenanlage & Umgebung', obj: 'Bahnhofstrasse 12', who: 'm.keller', icon: 'leaf', tone: 'bg-brand-soft text-brand-accent' },
      { time: '09:20', action: 'Wohnungsübergabe', obj: 'Whg. 201 – 3.5 Zi.', who: 'm.keller', icon: 'door', tone: 'bg-sky-50 text-sky-700', photo: true },
    ],
  },
];
---

<AppWindow active="Verlauf">
  <div class="p-3 space-y-2.5">
    <div class="flex gap-2">
      <div class="flex-1 flex items-center gap-1.5 h-8 rounded-lg border border-brand-border bg-white px-2.5 text-[10.5px] text-brand-muted">
        <Icon name="search" class="w-3.5 h-3.5" /> Ereignisse suchen…
      </div>
      <div class="h-8 rounded-lg border border-brand-border bg-white px-2.5 text-[10.5px] flex items-center">Letzte 48 Stunden</div>
    </div>
    {days.map((d) => (
      <div>
        <div class="flex items-center gap-1.5 text-[10px] font-semibold text-brand-ink py-1">
          <Icon name="tasks" class="w-3 h-3 text-brand-muted" /> {d.day}
        </div>
        <div class="relative pl-14 space-y-1.5">
          <div class="absolute left-[42px] top-2 bottom-2 w-px bg-brand-border"></div>
          {d.items.map((i) => (
            <div class="relative">
              <span class="absolute -left-14 top-2.5 text-[9.5px] text-brand-muted w-8 text-right">{i.time}</span>
              <span class="absolute -left-[17px] top-[14px] w-1.5 h-1.5 rounded-full bg-brand-sage"></span>
              <div class="flex items-center gap-2.5 rounded-lg bg-white border border-brand-border px-2.5 py-2">
                <span class={`w-7 h-7 rounded-md flex items-center justify-center shrink-0 ${i.tone}`}><Icon name={i.icon} class="w-3.5 h-3.5" /></span>
                <div class="min-w-0 flex-1 leading-tight">
                  <div class="text-[11px] font-semibold truncate">{i.action}</div>
                  <div class="text-[9.5px] text-brand-muted truncate">{i.obj} · {i.who}</div>
                </div>
                {i.photo && <Icon name="camera" class="w-3.5 h-3.5 text-brand-muted" />}
                <Icon name="chevron" class="w-3.5 h-3.5 text-brand-muted" />
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</AppWindow>

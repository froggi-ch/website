};

export interface Props {
  name: keyof typeof paths | string;
  class?: string;
  stroke?: number;
}

const { name, class: className = 'w-5 h-5', stroke = 1.8 } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <Fragment set:html={paths[name] ?? ''} />
</svg>

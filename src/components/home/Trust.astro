---
import Icon from '../Icon.astro';

// Only what the product and its deployment docs establish: hosting choice,
// object-based visibility, the append-only audit log, export, direct contact.
// No certifications, no hosting location, no SLA — none are decided.
const points = [
  { icon: 'server', title: 'Bei uns oder bei Ihnen', text: 'Gehostet von Froggi oder auf Ihrer eigenen Infrastruktur betrieben – mit getrenntem Speicher für aktive Daten und Archiv.' },
  { icon: 'users', title: 'Sichtbarkeit folgt dem Objekt', text: 'Jede Person sieht nur die Objekte, denen sie zugeordnet ist – und was darunter liegt.' },
  { icon: 'scroll', title: 'Belegbar', text: 'Berichte und Formulare sind versioniert, das Änderungsprotokoll ist nur anfügend.' },
  { icon: 'swap', title: 'Ihre Daten bleiben Ihre', text: 'Die Konfiguration als portable Datei exportieren, Daten über die Schnittstelle abrufen.' },
];
---

<section class="py-24 md:py-28 bg-white border-t border-brand-border">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid lg:grid-cols-[1fr_2fr] gap-10">
      <div>
        <span class="inline-block px-2.5 py-0.5 rounded-full text-[0.78rem] font-semibold mb-4 bg-brand-soft text-brand-accent">Sicherheit &amp; Betrieb</span>
        <h2 class="text-3xl md:text-[2.5rem] md:leading-[1.12] font-bold tracking-[-0.02em] text-brand-ink">Gebaut für sensible Daten.</h2>
        <p class="mt-4 text-brand-muted leading-relaxed">
          Fragen zu Betrieb und Datenschutz beantworten wir direkt –
          <a href="mailto:hello@froggi.ch" class="text-brand-accent font-semibold hover:underline">hello@froggi.ch</a>.
        </p>
        <a href="/funktionen#sicherheit" class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-accent hover:underline">
          Mehr zu Sicherheit <Icon name="arrow" class="w-4 h-4" stroke={2} />
        </a>
      </div>
      <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-7">
        {points.map((p) => (
          <li class="flex gap-3.5">
            <span class="w-9 h-9 rounded-full bg-tone-green-bg text-tone-green flex items-center justify-center shrink-0"><Icon name={p.icon} class="w-[18px] h-[18px]" /></span>
            <div>
              <h3 class="font-semibold text-brand-ink">{p.title}</h3>
              <p class="mt-1 text-sm text-brand-muted leading-relaxed">{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

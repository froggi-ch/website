---
export interface Props {
  title: string;
  description: string;
  icon: string; // SVG path(s) as string
}

const { title, description, icon } = Astro.props;
---

<div class="group relative bg-brand-surface rounded-xl p-6 border border-brand-border hover:border-brand-emerald/40 transition-colors duration-200">
  <!-- Emerald icon container -->
  <div class="w-10 h-10 rounded-lg bg-brand-emerald/10 flex items-center justify-center mb-4 group-hover:bg-brand-emerald/20 transition-colors">
    <svg class="w-5 h-5 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
      <Fragment set:html={icon} />
    </svg>
  </div>
  <h3 class="text-base font-semibold text-brand-text mb-2">{title}</h3>
  <p class="text-sm text-brand-muted leading-relaxed">{description}</p>
</div>

---
import TasksMock from './mock/TasksMock.astro';
import Icon from './Icon.astro';

const sectors = [
  { label: 'Pflege & Betreuung', icon: 'heart' },
  { label: 'Liegenschaftsverwaltung', icon: 'building' },
  { label: 'Hauswartung & Facility', icon: 'wrench' },
  { label: 'Reinigung & Unterhalt', icon: 'broom' },
];
---

<section class="relative overflow-hidden pt-28 md:pt-36 pb-20">
  <div
    class="absolute inset-x-0 top-0 h-[640px] pointer-events-none"
    style="background: radial-gradient(60% 55% at 50% 0%, #e1efe5 0%, rgba(246,249,247,0) 100%);"
  ></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
    <div class="max-w-4xl mx-auto text-center">
      <a href="#templates" class="inline-flex items-center gap-2 rounded-full border border-brand-sage/70 bg-white/70 px-3 py-1 text-xs font-medium text-brand-accent hover:bg-white transition-colors">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-accent"></span>
        Neu: Vorlagen-Marktplatz, Aufgaben &amp; Alarme
        <Icon name="arrow" class="w-3.5 h-3.5" />
      </a>

      <h1 class="mt-6 text-[2.3rem] leading-[1.08] sm:text-6xl md:text-[4.25rem] font-bold tracking-tight text-brand-ink">
        Dokumentieren, was&nbsp;zählt.<br />
        <span class="text-brand-accent">Sehen, was fällig&nbsp;ist.</span>
      </h1>

      <p class="mt-6 text-lg md:text-xl text-brand-muted leading-relaxed max-w-2xl mx-auto">
        Froggi ist die Dokumentationsplattform für Teams im Einsatz. Ihre eigenen Formulare,
        erfasst im Browser oder offline auf dem Handy – mit lückenlosem Verlauf und Aufgaben pro Objekt.
      </p>

      <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="#contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-brand-accent text-white font-semibold hover:bg-brand-accent-dark transition-colors shadow-[0_6px_20px_-6px_rgba(67,107,78,0.55)]">
          Demo anfragen <Icon name="arrow" class="w-4 h-4" stroke={2} />
        </a>
        <a href="#product" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-brand-border bg-white text-brand-ink font-medium hover:border-brand-sage transition-colors">
          So funktioniert's
        </a>
      </div>
    </div>

    <div class="relative mt-16 md:mt-20 max-w-5xl mx-auto">
      <TasksMock />
    </div>

    <div class="mt-14 text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-muted mb-5">Gebaut für</p>
      <div class="flex flex-wrap justify-center gap-2.5">
        {sectors.map((s) => (
          <span class="inline-flex items-center gap-2 rounded-full bg-white border border-brand-border px-4 py-2 text-sm text-brand-ink">
            <Icon name={s.icon} class="w-4 h-4 text-brand-accent" /> {s.label}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

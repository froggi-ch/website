---
import TasksMock from './mock/TasksMock.astro';
import Icon from './Icon.astro';

const sectors = [
  { label: 'Pflege & Betreuung', icon: 'heart', tone: 'bg-tone-red-bg text-tone-red' },
  { label: 'Liegenschaftsverwaltung', icon: 'building', tone: 'bg-tone-blue-bg text-tone-blue' },
  { label: 'Hauswartung & Facility', icon: 'wrench', tone: 'bg-tone-amber-bg text-tone-amber' },
  { label: 'Reinigung & Unterhalt', icon: 'sparkle', tone: 'bg-tone-violet-bg text-tone-violet' },
];
---

<section class="relative overflow-hidden pt-28 md:pt-36 pb-20">
  <div
    class="absolute inset-x-0 top-0 h-[680px] pointer-events-none"
    style="background: radial-gradient(60% 55% at 50% 0%, #e1efe5 0%, rgba(246,249,247,0) 100%);"
  ></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
    <div class="max-w-4xl mx-auto text-center">
      <a href="#ai" class="inline-flex items-center gap-2 rounded-full border border-brand-border bg-white pl-1 pr-3 py-1 text-[0.82rem] text-brand-ink shadow-lift hover:border-brand-sage transition-colors">
        <span class="px-2 py-0.5 rounded-full bg-brand-soft text-brand-accent font-semibold">Neu</span>
        Ihre KI anbinden, Hilfe-Center &amp; geführte Touren
        <Icon name="arrow" class="w-3.5 h-3.5 text-brand-muted" />
      </a>

      <h1 class="mt-7 text-[2.4rem] leading-[1.06] sm:text-6xl md:text-[4.4rem] font-bold tracking-[-0.03em] text-brand-ink">
        Dokumentieren, was&nbsp;zählt.<br />
        <span class="text-brand-accent">Sehen, was fällig&nbsp;ist.</span>
      </h1>

      <p class="mt-6 text-lg md:text-xl text-brand-muted leading-relaxed max-w-2xl mx-auto">
        Froggi ist die Dokumentationsplattform für Teams im Einsatz. Ihre eigenen Formulare,
        erfasst im Browser oder offline auf dem Handy – mit lückenlosem Verlauf und Aufgaben pro Objekt.
      </p>

      <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="#contact" class="inline-flex items-center gap-2 px-6 py-3 rounded-card bg-brand-accent text-white font-semibold hover:bg-brand-accent-dark transition-colors shadow-glow">
          Demo anfragen <Icon name="arrow" class="w-4 h-4" stroke={2} />
        </a>
        <a href="#product" class="inline-flex items-center gap-2 px-6 py-3 rounded-card border border-brand-border bg-white text-brand-ink font-medium hover:border-brand-sage transition-colors">
          So funktioniert's
        </a>
      </div>
    </div>

    <div class="relative mt-16 md:mt-20 max-w-5xl mx-auto">
      <TasksMock />
    </div>

    <div class="mt-14 text-center">
      <p class="text-[0.74rem] font-bold uppercase tracking-[0.06em] text-brand-muted mb-5">Gebaut für</p>
      <div class="flex flex-wrap justify-center gap-2.5">
        {sectors.map((s) => (
          <span class="inline-flex items-center gap-2.5 rounded-card bg-white border border-brand-border pl-1.5 pr-4 py-1.5 text-[0.94rem] text-brand-ink">
            <span class={`w-7 h-7 rounded-lg flex items-center justify-center ${s.tone}`}><Icon name={s.icon} class="w-4 h-4" /></span>
            {s.label}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

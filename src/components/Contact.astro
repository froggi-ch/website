---
// Replace YOUR_FORM_ID with your actual Formspree form ID after signing up at formspree.io
const FORMSPREE_ID = 'YOUR_FORM_ID';
---

<section id="contact" class="py-24 px-6">
  <div class="max-w-2xl mx-auto">
    <div class="text-center mb-12">
      <span class="inline-block text-brand-emerald text-sm font-semibold uppercase tracking-widest mb-3">Contact</span>
      <h2 class="text-3xl md:text-4xl font-bold text-brand-text">Ready to see Froggi in action?</h2>
      <p class="mt-4 text-brand-muted">
        Reach out to schedule a demo or ask about deployment options for your facility.
      </p>
    </div>

    <div class="bg-brand-surface rounded-2xl border border-brand-border p-8">
      <form
        action={`https://formspree.io/f/${FORMSPREE_ID}`}
        method="POST"
        class="flex flex-col gap-5"
      >
        <!-- Name -->
        <div>
          <label for="name" class="block text-sm font-medium text-brand-text mb-1.5">
            Full Name <span class="text-brand-emerald">*</span>
          </label>
          <input
            id="name"
            type="text"
            name="name"
            required
            placeholder="Jane Smith"
            class="w-full px-4 py-2.5 rounded-lg bg-brand-bg border border-brand-border text-brand-text placeholder-brand-muted/60 text-sm focus:outline-none focus:border-brand-emerald focus:ring-1 focus:ring-brand-emerald transition-colors"
          />
        </div>

        <!-- Email -->
        <div>
          <label for="email" class="block text-sm font-medium text-brand-text mb-1.5">
            Work Email <span class="text-brand-emerald">*</span>
          </label>
          <input
            id="email"
            type="email"
            name="email"
            required
            placeholder="jane@facility.org"
            class="w-full px-4 py-2.5 rounded-lg bg-brand-bg border border-brand-border text-brand-text placeholder-brand-muted/60 text-sm focus:outline-none focus:border-brand-emerald focus:ring-1 focus:ring-brand-emerald transition-colors"
          />
        </div>

        <!-- Facility / Organisation -->
        <div>
          <label for="org" class="block text-sm font-medium text-brand-text mb-1.5">
            Facility / Organisation
          </label>
          <input
            id="org"
            type="text"
            name="organisation"
            placeholder="City Care Centre"
            class="w-full px-4 py-2.5 rounded-lg bg-brand-bg border border-brand-border text-brand-text placeholder-brand-muted/60 text-sm focus:outline-none focus:border-brand-emerald focus:ring-1 focus:ring-brand-emerald transition-colors"
          />
        </div>

        <!-- Message -->
        <div>
          <label for="message" class="block text-sm font-medium text-brand-text mb-1.5">
            Message <span class="text-brand-emerald">*</span>
          </label>
          <textarea
            id="message"
            name="message"
            required
            rows="4"
            placeholder="Tell us about your facility and what you're looking for..."
            class="w-full px-4 py-2.5 rounded-lg bg-brand-bg border border-brand-border text-brand-text placeholder-brand-muted/60 text-sm focus:outline-none focus:border-brand-emerald focus:ring-1 focus:ring-brand-emerald transition-colors resize-none"
          ></textarea>
        </div>

        <!-- Submit -->
        <button
          type="submit"
          class="w-full py-3 px-6 rounded-xl bg-brand-emerald text-white font-semibold text-sm hover:bg-brand-emerald-dark transition-colors"
          style="box-shadow: 0 4px 16px rgba(16,185,129,0.20);"
        >
          Send Message
        </button>

        <p class="text-xs text-brand-muted text-center">
          Prefer email? Write to us directly at{' '}
          <a href="mailto:hello@froggi.ch" class="text-brand-emerald hover:underline">
            hello@froggi.ch
          </a>
        </p>
      </form>
    </div>
  </div>
</section>

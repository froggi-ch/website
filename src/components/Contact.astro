---
// Replace YOUR_FORM_ID with your actual Formspree form ID after signing up at formspree.io
const FORMSPREE_ID = 'YOUR_FORM_ID';

const field =
  'w-full px-3.5 py-2.5 rounded-lg bg-white border border-brand-border text-brand-ink placeholder-brand-muted/70 text-sm focus:outline-none focus:border-brand-accent focus:ring-2 focus:ring-brand-accent/20 transition';
---

<section id="contact" class="py-24 md:py-32 bg-white border-t border-brand-border">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 grid md:grid-cols-[1fr_1.1fr] gap-12 md:gap-16">
    <div>
      <img src="/froggi-frog.svg" alt="" width="64" height="64" class="mb-6" />
      <span class="inline-block text-brand-accent text-xs font-semibold uppercase tracking-[0.16em] mb-3">Kontakt</span>
      <h2 class="text-3xl md:text-[2.5rem] md:leading-[1.15] font-bold tracking-tight text-brand-ink">Mach den Sprung.</h2>
      <p class="mt-4 text-lg text-brand-muted leading-relaxed">
        Wir zeigen Ihnen Froggi mit Ihren eigenen Abläufen – online oder vor Ort.
      </p>
      <p class="mt-8 text-sm text-brand-muted">
        Lieber direkt per E-Mail?<br />
        <a href="mailto:hello@froggi.ch" class="text-brand-accent font-semibold hover:underline">hello@froggi.ch</a>
      </p>
    </div>

    <form action={`https://formspree.io/f/${FORMSPREE_ID}`} method="POST" class="rounded-2xl bg-brand-bg border border-brand-border p-6 sm:p-8 grid sm:grid-cols-2 gap-4">
      <div>
        <label for="name" class="block text-sm font-medium text-brand-ink mb-1.5">Name <span class="text-brand-accent">*</span></label>
        <input id="name" type="text" name="name" required placeholder="Maria Muster" class={field} />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-brand-ink mb-1.5">E-Mail <span class="text-brand-accent">*</span></label>
        <input id="email" type="email" name="email" required placeholder="maria@verwaltung.ch" class={field} />
      </div>
      <div class="sm:col-span-2">
        <label for="org" class="block text-sm font-medium text-brand-ink mb-1.5">Organisation</label>
        <input id="org" type="text" name="organisation" placeholder="Verwaltung oder Einrichtung" class={field} />
      </div>
      <div class="sm:col-span-2">
        <label for="message" class="block text-sm font-medium text-brand-ink mb-1.5">Nachricht <span class="text-brand-accent">*</span></label>
        <textarea id="message" name="message" required rows="4" placeholder="Was möchten Sie dokumentieren, und wie viele Personen arbeiten damit?" class={`${field} resize-none`}></textarea>
      </div>
      <button type="submit" class="sm:col-span-2 w-full py-3 rounded-xl bg-brand-accent text-white font-semibold text-sm hover:bg-brand-accent-dark transition-colors">
        Nachricht senden
      </button>
    </form>
  </div>
</section>

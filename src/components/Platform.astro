---
const platforms = [
  {
    title: 'Web',
    description: 'Vollständige Browseranwendung. Keine Installation erforderlich – funktioniert in jedem modernen Browser, einschliesslich Safari, Chrome und Firefox.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />',
  },
  {
    title: 'iOS & Android',
    description: 'Native mobile Apps mit denselben Daten und Funktionen wie die Web-App. Optimiert für Tablet und Smartphone, mit offlinefähigem Design.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />',
  },
  {
    title: 'NFC-Authentifizierung',
    description: 'Mitarbeitende tippen auf ein registriertes NFC-Tag zur sofortigen Anmeldung. Entwickelt für schnellen, freihändigen Zugriff in klinischen Umgebungen, wo Tippen unpraktisch ist.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" />',
  },
];

const languages = [
  { code: 'EN', label: 'English' },
  { code: 'DE', label: 'Deutsch' },
  { code: 'IT', label: 'Italiano' },
  { code: 'FR', label: 'Français' },
  { code: 'RO', label: 'Română' },
];
---

<section id="platform" class="py-24 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <span class="inline-block text-brand-emerald text-sm font-semibold uppercase tracking-widest mb-3">Plattform</span>
      <h2 class="text-3xl md:text-4xl font-bold text-brand-text">Jedes Gerät, jede Sprache</h2>
      <p class="mt-4 text-brand-muted max-w-xl mx-auto">
        Froggi begleitet Ihr Team überall – im Büro, am Bett oder unterwegs.
      </p>
    </div>

    <!-- Platform cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      {platforms.map((p) => (
        <div class="text-center bg-brand-surface rounded-xl p-8 border border-brand-border">
          <div class="w-14 h-14 rounded-2xl bg-brand-emerald/10 flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <Fragment set:html={p.icon} />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-brand-text mb-3">{p.title}</h3>
          <p class="text-sm text-brand-muted leading-relaxed">{p.description}</p>
        </div>
      ))}
    </div>

    <!-- Language pills -->
    <div class="text-center">
      <p class="text-sm text-brand-muted mb-5 font-medium uppercase tracking-widest">Verfügbar in</p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        {languages.map((l) => (
          <span
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-brand-emerald/30 bg-brand-emerald/5 text-sm font-medium text-brand-emerald"
          >
            <span class="font-bold">{l.code}</span>
            <span class="text-brand-emerald/70">·</span>
            <span>{l.label}</span>
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

// The homepage's short version: the idea in three steps, then one card per
// page that tells the rest. Detail lives on those pages, not here.
const steps = [
  { n: 1, title: 'Objekt', text: 'Worum es geht – eine Wohnung, eine Anlage, eine Person.', icon: 'cube' },
  { n: 2, title: 'Aktion', text: 'Was gemacht wurde. Nur Aktionen, die zum Objekt passen.', icon: 'clipboard' },
  { n: 3, title: 'Details', text: 'Ihre Felder, mit Fotos und Standort. Fertig.', icon: 'check' },
];

const pages = [
  { href: '/produkt', icon: 'tasks', tone: 'bg-tone-green-bg text-tone-green', title: 'So funktioniert’s', text: 'Reporteditor, Erfassen, Verlauf und Aufgaben – Schritt für Schritt.' },
  { href: '/produkt#app', icon: 'offline', tone: 'bg-tone-amber-bg text-tone-amber', title: 'App, auch offline', text: 'Dieselben Formulare auf dem Handy – im Keller genauso wie im Büro.' },
  { href: '/funktionen#vorlagen', icon: 'store', tone: 'bg-tone-blue-bg text-tone-blue', title: 'Vorlagen', text: 'Fertige Branchenvorlage für die Immobilienbewirtschaftung (CH).' },
  { href: '/ki', icon: 'plug', tone: 'bg-tone-violet-bg text-tone-violet', title: 'Ihre KI anbinden', text: 'Claude, ChatGPT oder ein eigener Agent – über MCP, mit Ihren Rechten.' },
];
---

<section class="pt-24 md:pt-28 pb-8 bg-white border-t border-brand-border">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <SectionHeading
      eyebrow="So einfach"
      title="Objekt, Aktion, Details."
      lead="Sie beschreiben Ihre Arbeit einmal – danach erfasst Ihr Team sie in drei Schritten, immer gleich."
    />
    <ol class="grid md:grid-cols-3 gap-3">
      {steps.map((s, i) => (
        <li class="relative rounded-rail bg-brand-bg border border-brand-border p-6">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-full bg-brand-accent text-white font-bold flex items-center justify-center">{s.n}</span>
            <span class="text-lg font-semibold text-brand-ink">{s.title}</span>
            {i < 2 && <Icon name="chevron" class="hidden md:block w-5 h-5 text-brand-sage ml-auto" />}
          </div>
          <p class="mt-3 text-sm text-brand-muted leading-relaxed">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="pt-16 pb-24 md:pb-28 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
      {pages.map((p) => (
        <a href={p.href} class="group rounded-rail bg-white border border-brand-border p-6 flex flex-col hover:border-brand-sage hover:shadow-lift transition">
          <span class={`w-[42px] h-[42px] rounded-card flex items-center justify-center ${p.tone}`}><Icon name={p.icon} class="w-5 h-5" /></span>
          <h3 class="mt-5 font-semibold text-brand-ink">{p.title}</h3>
          <p class="mt-2 text-sm text-brand-muted leading-relaxed flex-1">{p.text}</p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-accent">
            Mehr erfahren <Icon name="arrow" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" stroke={2} />
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

---
const year = new Date().getFullYear();
---

<footer class="border-t border-brand-border py-10 px-6">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <!-- Logo & tagline -->
    <div class="flex items-center gap-3">
      <img src="/app-icon.png" alt="Froggi" width="28" height="28" class="rounded-md" />
      <span class="text-sm font-semibold text-brand-text">Froggi</span>
      <span class="text-brand-border text-sm">·</span>
      <span class="text-sm text-brand-muted">Healthcare Management Platform</span>
    </div>

    <!-- Links -->
    <div class="flex items-center gap-6 text-sm text-brand-muted">
      <a href="/legal" class="hover:text-brand-text transition-colors">Legal &amp; Privacy</a>
      <a href="#contact" class="hover:text-brand-text transition-colors">Contact</a>
      <span class="text-brand-border">&copy; {year} Froggi. All rights reserved.</span>
    </div>
  </div>
</footer>

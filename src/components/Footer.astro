---
const year = new Date().getFullYear();
---

<footer class="py-10 px-4 sm:px-6 border-t border-brand-border bg-white">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-5">
    <div class="flex items-center gap-2.5">
      <img src="/froggi-frog.svg" alt="" width="24" height="24" />
      <span class="text-sm font-bold text-brand-accent-dark">Froggi</span>
      <span class="text-sm text-brand-muted">· Dokumentation für Teams im Einsatz</span>
    </div>
    <div class="flex flex-wrap justify-center items-center gap-x-6 gap-y-2 text-sm text-brand-muted">
      <a href="/legal" class="hover:text-brand-ink transition-colors">Rechtliches &amp; Datenschutz</a>
      <a href="/produkt" class="hover:text-brand-ink transition-colors">Produkt</a>
      <a href="/funktionen" class="hover:text-brand-ink transition-colors">Funktionen</a>
      <a href="/ki" class="hover:text-brand-ink transition-colors">KI</a>
      <a href="/preise" class="hover:text-brand-ink transition-colors">Preise</a>
      <a href="/kontakt" class="hover:text-brand-ink transition-colors">Kontakt</a>
      <span>&copy; {year} Froggi · Schweiz</span>
    </div>
  </div>
</footer>

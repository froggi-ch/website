---
// timo's own header: the app icon and name instead of the Froggi platform's menus.
// timo is a one-page site, so the links are anchors on /timo plus its legal page; the
// small "froggi" link on the right leads back to the brand's landing page.
const links = [
  { label: 'Funktionen', href: '/timo#funktionen' },
  { label: 'Preise', href: '/timo#preise' },
  { label: 'Hilfe', href: '/timo#support' },
  { label: 'Datenschutz', href: '/timo/legal' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const pill = 'px-3 py-1.5 rounded-lg text-[0.94rem] transition-colors';
const on = 'bg-brand-soft text-brand-accent font-semibold';
const off = 'text-brand-ink hover:bg-brand-soft hover:text-brand-accent';
---

<nav aria-label="timo" class="fixed top-0 inset-x-0 z-50 bg-white/90 backdrop-blur-md border-b border-brand-border">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-[54px] flex items-center justify-between gap-6">
    <a href="/timo" class="flex items-center gap-2 text-[1.1rem] font-bold text-brand-ink rounded-lg">
      <img src="/timo/icon.png" alt="" width="28" height="28" class="rounded-[7px]" />
      timo
    </a>

    <ul class="hidden md:flex items-center gap-1 mr-auto">
      {links.map((l) => (
        <li>
          <a href={l.href} aria-current={path === l.href ? 'page' : undefined} class={`${pill} ${path === l.href ? on : off}`}>{l.label}</a>
        </li>
      ))}
    </ul>

    <a href="/" class="hidden md:inline-flex items-center gap-1.5 text-sm text-brand-muted hover:text-brand-accent rounded-lg">
      <img src="/froggi-frog.svg" alt="" width="18" height="18" />
      von froggi
    </a>

    <button
      type="button"
      class="md:hidden p-2 -mr-2 bg-transparent border-0 text-brand-muted hover:text-brand-ink rounded-lg"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="timo-mobile-menu"
      data-timo-toggle
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div id="timo-mobile-menu" hidden class="md:hidden px-4 pb-5 pt-2 border-t border-brand-border bg-white">
    {links.map((l) => (
      <a href={l.href} class={`block py-2 px-2 rounded-lg text-[0.95rem] ${path === l.href ? on : 'font-medium text-brand-ink hover:bg-brand-soft'}`}>{l.label}</a>
    ))}
    <a href="/" class="mt-3 flex items-center gap-2 py-2 px-2 rounded-lg text-sm text-brand-muted">
      <img src="/froggi-frog.svg" alt="" width="18" height="18" />
      von froggi
    </a>
  </div>
</nav>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-timo-toggle]')!;
  const menu = document.getElementById('timo-mobile-menu')!;
  toggle.addEventListener('click', () => {
    const open = menu.hidden;
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Menü schliessen' : 'Menü öffnen');
  });
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
    }
  });
</script>

---
const pillars = [
  {
    title: 'Rollenbasierte Zugriffskontrolle',
    description: 'Jede Person sieht nur, was ihre Rolle erlaubt. Feingranulare Berechtigungen für Administrierende, klinisches Personal und lesende Zugriffe – zentral verwaltet. Unterstützt LDAP/SSO-Integration für Unternehmensumgebungen.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />',
  },
  {
    title: 'Unveränderliches Audit-Protokoll',
    description: 'Hash-Ketten-Integrität bedeutet, dass Audit-Einträge nicht rückwirkend geändert werden können. Vollständige Nachverfolgung jeder Datenänderung – wer, wann – und erfüllt regulatorische Compliance-Anforderungen ab der ersten Minute.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />',
  },
  {
    title: 'Cloud-native Infrastruktur',
    description: 'Kubernetes-native Bereitstellung mit horizontaler Skalierung und Zero-Downtime-Updates. Betreiben Sie die Lösung auf Ihrer eigenen Infrastruktur oder überlassen Sie uns das Management. Mit Cloudflare Tunnel, Vault Secrets und Redis-Session-Caching.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />',
  },
];
---

<section id="security" class="py-24 px-6 bg-brand-surface/30">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <span class="inline-block text-brand-emerald text-sm font-semibold uppercase tracking-widest mb-3">Sicherheit & Vertrauen</span>
      <h2 class="text-3xl md:text-4xl font-bold text-brand-text">Entwickelt für regulierte Umgebungen</h2>
      <p class="mt-4 text-brand-muted max-w-xl mx-auto">
        Gesundheitsdaten erfordern höchste Standards. Froggi ist von Grund auf für Sicherheit, Compliance und Zuverlässigkeit ausgelegt.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {pillars.map((p) => (
        <div class="relative bg-brand-surface rounded-xl p-8 border border-brand-border overflow-hidden">
          <!-- Subtle emerald corner accent -->
          <div class="absolute top-0 right-0 w-24 h-24 opacity-5 rounded-bl-full" style="background: radial-gradient(circle at top right, #10B981, transparent 70%);"></div>

          <div class="w-12 h-12 rounded-xl bg-brand-emerald/10 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-brand-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <Fragment set:html={p.icon} />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-brand-text mb-3">{p.title}</h3>
          <p class="text-sm text-brand-muted leading-relaxed">{p.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
